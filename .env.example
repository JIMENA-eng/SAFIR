# ============================================================
# SAFIR · Variables de configuración (PLANTILLA)
# ============================================================
# IMPORTANTE
#  - Este archivo es solo un ejemplo y NO contiene secretos reales.
#  - Java NO lee archivos .env por sí solo: estas variables hay que
#    definirlas como variables de entorno del sistema, en el
#    «Run configuration» de NetBeans o en el setenv de Tomcat
#    (ver la sección «Configuración» del README).
#  - Alternativa: pasarlas como propiedades de la JVM con -D
#    (por ejemplo -DSAFIR_DB_CLAVE=...). Excepciones: las de PayPal y
#    SAFIR_BASE_URL / SAFIR_YAPE_* / SAFIR_UPLOADS / SAFIR_IMPORTACIONES
#    solo se leen como variables de entorno.
#  - Nunca subas a Git el archivo con tus valores reales.
# ============================================================

# ---------- Base de datos (PostgreSQL) ----------
# OBLIGATORIA: sin esta clave la aplicación no conecta.
SAFIR_DB_CLAVE=cambia-esta-clave
# Opcionales (valores por defecto entre paréntesis):
SAFIR_DB_URL=jdbc:postgresql://localhost:5432/safir
SAFIR_DB_USUARIO=postgres

# ---------- Dirección pública de la aplicación (opcional) ----------
# Sin «/» final y con el contexto. Se usa en correos y en el retorno del
# login social. Si falta, se deduce de la petición.
SAFIR_URL_BASE=http://localhost:8080/safir
SAFIR_BASE_URL=http://localhost:8080/safir

# ---------- Correo SMTP (opcional) ----------
# Si no se definen HOST, USER y PASS, el código de verificación se
# imprime en la consola del servidor (modo desarrollo).
SAFIR_SMTP_HOST=smtp.ejemplo.com
SAFIR_SMTP_PORT=587
SAFIR_SMTP_USER=correo@ejemplo.com
SAFIR_SMTP_PASS=clave-o-contrasena-de-aplicacion
SAFIR_SMTP_FROM=correo@ejemplo.com

# ---------- Pagos con PayPal (opcional) ----------
# Credenciales de tu app en developer.paypal.com. Sin ellas, PayPal
# queda desactivado.
PAYPAL_CLIENT_ID=tu-client-id
PAYPAL_SECRET=tu-secret
# Por defecto es sandbox. Producción: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---------- Pagos con Yape (opcional) ----------
SAFIR_YAPE_NUMERO=999999999
SAFIR_YAPE_TITULAR=Nombre del titular

# ---------- Inicio de sesión social (opcional) ----------
# Cada proveedor se activa solo si tiene ID y SECRET.
SAFIR_GOOGLE_ID=
SAFIR_GOOGLE_SECRET=
SAFIR_FACEBOOK_ID=
SAFIR_FACEBOOK_SECRET=
SAFIR_X_ID=
SAFIR_X_SECRET=

# ---------- Archivos y contacto (opcional) ----------
# Carpeta de fotos y portadas subidas (defecto: ~/safir-uploads)
SAFIR_UPLOADS=
# Carpeta de PDF/archivos importados (defecto: ~/safir-importaciones)
SAFIR_IMPORTACIONES=
# Correo de contacto que se muestra en la política de privacidad
SAFIR_PRIVACIDAD_CORREO=
