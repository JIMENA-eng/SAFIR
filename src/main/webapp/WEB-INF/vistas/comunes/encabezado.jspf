<%-- Encabezado compartido (inicio y perfil). Requiere encabezado-datos.jspf, encabezadoinicio.css e inicio.js. --%>
<%
    // TAREA 6: buscador centrado en el encabezado.
    // No se muestra en el inicio (comunes/inicio.jsp), que ya tiene su propio buscador.
    // Otra vista puede ocultarlo con request.setAttribute("ocultarBuscadorEncabezado", true).
    String vistaActual = request.getServletPath();
    boolean mostrarBuscador = !Boolean.TRUE.equals(request.getAttribute("ocultarBuscadorEncabezado"))
            && (vistaActual == null || !vistaActual.endsWith("/comunes/inicio.jsp"));
%>
<!-- S&#237;mbolo del logo (aproximaci&#243;n vectorial; reemplazar por el archivo oficial) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <path id="star" d="M0,-1 Q.12,-.12 1,0 Q.12,.12 0,1 Q-.12,.12 -1,0 Q-.12,-.12 0,-1Z"/>
    <linearGradient id="orb" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#CBC9F4"/><stop offset="1" stop-color="#A9A5EE"/>
    </linearGradient>
    <symbol id="plane-color" viewBox="300 230 380 280">
      <use href="#star" transform="translate(368 275) scale(35)" fill="#5051AE"/>
      <use href="#star" transform="translate(322 327) scale(17)" fill="#5051AE"/>
      <path d="M388 405C330 440 310 480 360 493C420 502 480 482 528 459C470 475 400 478 372 462C350 448 360 425 388 405Z" fill="url(#orb)"/>
      <polygon points="368,350 642,258 440,382" fill="#CBC9F4"/>
      <polygon points="440,382 642,258 458,461" fill="#5051AE"/>
      <polygon points="458,461 440,382 500,420" fill="#28296D"/>
      <polygon points="642,258 545,453 484,404" fill="#BDB9F2"/>
      <path d="M620 345C662 345 676 366 656 396C640 419 610 431 582 439C620 421 646 400 646 380C646 365 636 352 620 345Z" fill="url(#orb)"/>
    </symbol>
    <symbol id="plane-white" viewBox="300 230 380 280">
      <use href="#star" transform="translate(368 275) scale(35)" fill="#F4F3FF"/>
      <use href="#star" transform="translate(322 327) scale(17)" fill="#F4F3FF"/>
      <path d="M388 405C330 440 310 480 360 493C420 502 480 482 528 459C470 475 400 478 372 462C350 448 360 425 388 405Z" fill="#B7B6D6"/>
      <polygon points="368,350 642,258 440,382" fill="#C9C8DC"/>
      <polygon points="440,382 642,258 458,461" fill="#A9A8C6"/>
      <polygon points="458,461 440,382 500,420" fill="#8E8DB0"/>
      <polygon points="642,258 545,453 484,404" fill="#E9E8F5"/>
      <path d="M620 345C662 345 676 366 656 396C640 419 610 431 582 439C620 421 646 400 646 380C646 365 636 352 620 345Z" fill="#B7B6D6"/>
    </symbol>
  </defs>
</svg>

<header class="bar">
  <div class="wrap<%= mostrarBuscador ? " con-buscador" : "" %>">
    <a class="brand" href="<%= contexto %>/auth/inicio" aria-label="SAFIR, inicio">
      <svg viewBox="0 0 380 280" role="img" aria-hidden="true"><use href="#plane-white"/></svg>
      <span>SAFIR</span>
    </a>
    <nav aria-label="Principal">
      <%-- TAREA 3: "Cat&#225;logo" ahora es un desglose con todas las categor&#237;as --%>
      <div class="cat-wrap">
        <button class="cat-btn" id="catBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="catMenu">
          Cat&#225;logo
          <svg class="caret" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg>
        </button>
        <div class="menu" id="catMenu" role="menu" aria-label="Categor&#237;as" hidden>
          <a role="menuitem" class="cat-todo" href="<%= contexto %>/catalogo">Ver todo el cat&#225;logo</a>
          <% if (!generosMenu.isEmpty()) { %><div class="sep" role="separator"></div><% } %>
          <% for (com.safir.modelo.Genero gm : generosMenu) { %>
          <a role="menuitem" href="<%= contexto %>/catalogo/categoria?id=<%= gm.getId() %>">
            <span><%= esc(gm.getNombre()) %></span><small><%= gm.getTotalObras() %></small>
          </a>
          <% } %>
        </div>
      </div>
      <a href="<%= contexto %>/biblioteca">Mi biblioteca</a>
      <% if (esAutor) { %>
      <a href="<%= contexto %>/autor/obra/nueva">Crear obra</a>
      <% } %>
    </nav>
    <% if (mostrarBuscador) { %>
    <%-- TAREA 6: buscador del encabezado (en todas las vistas menos el inicio) --%>
    <form class="hdr-search" id="hdrSearchForm" role="search" method="get" action="<%= contexto %>/catalogo" data-contexto="<%= contexto %>" data-sugerencias-url="<%= contexto %>/buscar/sugerencias">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="hdrSearchInput" name="q" placeholder="Buscar obras, autores o etiquetas&#8230;" aria-label="Buscar obras" autocomplete="off" maxlength="120">
    </form>
    <%-- TAREA 7: sugerencias de obras y autores mientras se escribe --%>
    <script src="<%= contexto %>/assets/js/buscador.js" defer></script>
    <% } %>
    <button class="theme-toggle" id="themeBtn" type="button" aria-pressed="false">Modo noche</button>
    <div class="header-actions">
      <div class="lang-wrap">
        <button class="icon-btn" id="langBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="langMenu" aria-label="Idioma" title="Idioma"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/></svg></button>
        <%-- TAREA 4: la lista de idiomas la arma /assets/js/idioma.js (lo inyecta IdiomaFilter) --%>
        <div class="menu" id="langMenu" hidden></div>
      </div>
      <%-- TAREA 5: contador de no leidos + desglose al pasar el cursor (assets/js/avisos.js) --%>
      <div class="aviso-wrap" data-aviso="mensajes" data-resumen-url="<%= contexto %>/notificaciones/resumen">
        <a class="icon-btn" href="<%= contexto %>/notificaciones?ver=mensajes" aria-label="Mensajes<%= mensajesNoLeidos > 0 ? " (" + mensajesNoLeidos + " sin leer)" : "" %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg><span class="badge" data-badge <%= mensajesNoLeidos > 0 ? "" : "hidden" %>><%= mensajesNoLeidos > 99 ? "99+" : String.valueOf(mensajesNoLeidos) %></span></a>
        <div class="aviso-pop" role="region" aria-label="Mensajes recientes" hidden>
          <div class="aviso-cab"><b>Mensajes</b><span data-resumen></span></div>
          <ul class="aviso-lista" data-lista><li class="aviso-vacio">Cargando&#8230;</li></ul>
          <a class="aviso-todas" href="<%= contexto %>/notificaciones?ver=mensajes">Ver todos los mensajes</a>
        </div>
      </div>
      <div class="aviso-wrap" data-aviso="actividad" data-resumen-url="<%= contexto %>/notificaciones/resumen">
        <a class="icon-btn" href="<%= contexto %>/notificaciones?ver=actividad" aria-label="Notificaciones<%= notifNoLeidas > 0 ? " (" + notifNoLeidas + " sin leer)" : "" %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9"/><path d="M10 20a2 2 0 0 0 4 0"/></svg><span class="badge" data-badge <%= notifNoLeidas > 0 ? "" : "hidden" %>><%= notifNoLeidas > 99 ? "99+" : String.valueOf(notifNoLeidas) %></span></a>
        <div class="aviso-pop" role="region" aria-label="Notificaciones recientes" hidden>
          <div class="aviso-cab"><b>Notificaciones</b><span data-resumen></span></div>
          <ul class="aviso-lista" data-lista><li class="aviso-vacio">Cargando&#8230;</li></ul>
          <a class="aviso-todas" href="<%= contexto %>/notificaciones?ver=actividad">Ver todas las notificaciones</a>
        </div>
      </div>
      <div class="menu-wrap">
        <button class="btn small user" id="userMenuBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="userMenu">
          <span class="avatar" aria-hidden="true"><%= avatarHtml %></span><b><%= nombreUsuario %></b>
          <svg class="caret" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg>
        </button>
        <div class="menu" id="userMenu" role="menu" aria-label="Men&#250; de usuario" hidden>
          <a class="profile-card" role="menuitem" href="<%= contexto %>/perfil#editar-perfil" aria-label="Editar perfil de <%= esc(sobrenombreMenu) %>">
            <span class="pc-cover">
              <% if (portadaRuta != null) { %><img src="<%= contexto %>/media/<%= esc(portadaRuta) %>" alt=""><% } %>
            </span>
            <span class="pc-avatar" aria-hidden="true"><%= avatarHtml %></span>
            <span class="pc-body">
              <span class="pc-names">
                <b><%= esc(sobrenombreMenu) %></b>
                <% if (!usuarioMenu.isEmpty()) { %><small>@<%= esc(usuarioMenu) %></small><% } %>
              </span>
              <span class="pc-edit" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              </span>
            </span>
          </a>
          <a role="menuitem" href="<%= contexto %>/auth/cuenta">Mi cuenta</a>
          <a role="menuitem" href="<%= contexto %>/biblioteca">Mi biblioteca</a>
          <a role="menuitem" href="<%= contexto %>/notificaciones">Notificaciones</a>
          <a role="menuitem" href="<%= contexto %>/notificaciones?ver=mensajes">Mensajes</a>
          <% if (esAutor) { %>
          <div class="sep" role="separator"></div>
          <a role="menuitem" href="<%= contexto %>/auth/cuenta#mis-obras">Mis obras</a>
          <a role="menuitem" href="<%= contexto %>/autor/obra/nueva">Crear obra</a>
          <% } %>
          <div class="sep" role="separator"></div>
          <a role="menuitem" href="#" data-pendiente>Configuraciones</a>
          <div class="sep" role="separator"></div>
          <a role="menuitem" class="logout" href="<%= contexto %>/auth/logout">Cerrar sesi&#243;n</a>
        </div>
      </div>
    </div>
  </div>
</header>
<script src="<%= contexto %>/assets/js/avisos.js" defer></script>
